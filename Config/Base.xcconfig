// Build settings a cloner may want to change. Everything else lives in the project.
//
// Do not edit this file to sign the app: copy Local.example.xcconfig to
// Local.xcconfig (gitignored) and set your own values there.

// Reverse-DNS prefix. The app is "$(APP_BUNDLE_PREFIX)", the widget is
// "$(APP_BUNDLE_PREFIX).widget", and the shared App Group is "group.$(APP_BUNDLE_PREFIX)".
APP_BUNDLE_PREFIX = com.example.timemoney
APP_GROUP_ID = group.$(APP_BUNDLE_PREFIX)

// Empty means "unsigned": fine for the simulator and for CI.
DEVELOPMENT_TEAM =

#include? "Local.xcconfig"
